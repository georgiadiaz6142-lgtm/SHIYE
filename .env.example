# Contains no credentials. Live transmission stays disabled until separately approved.
SHIYE_HOST=127.0.0.1
SHIYE_PORT=4176
SHIYE_SEGMENTATION_MODE=mock
SHIYE_RUNTIME_DIR=.local/shiye
SHIYE_TEMP_TTL_SECONDS=3600
# The TTL above is for synthetic mock fixtures only. Real-photo policy is pending.
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# Do not copy activation settings without confirming quota, photos and local retention.
SHIYE_BAIDU_APPROVED=false
SHIYE_BAIDU_MAX_CALLS=0
SHIYE_BAIDU_APPROVED_UNTIL=

# Explicit opt-in removes the local test count/deadline gates; provider billing still applies.
SHIYE_BAIDU_LIMITS_DISABLED=false
