# Contains no credentials. Live transmission stays disabled until separately approved.
SHIYE_HOST=127.0.0.1
SHIYE_PORT=4176
SHIYE_SEGMENTATION_MODE=mock
SHIYE_RUNTIME_DIR=.local/shiye
SHIYE_TEMP_TTL_SECONDS=3600
# The TTL above is for synthetic mock fixtures only. Real-photo policy is pending.
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# Do not copy activation settings without confirming quota, photos and local retention.
SHIYE_BAIDU_APPROVED=false
SHIYE_BAIDU_MAX_CALLS=0
SHIYE_BAIDU_APPROVED_UNTIL=

# Explicit opt-in removes the local test count/deadline gates; provider billing still applies.
SHIYE_BAIDU_LIMITS_DISABLED=false

# Extra Baidu image-recognition request for final sticker names (separate service billing).
SHIYE_BAIDU_NAMING_ENABLED=false

# Default remains local. Public gateway testing uses a separate environment, never .env.local.
SHIYE_DEPLOYMENT=local
# Cloud-test requires all of these, set in controlled platform environment configuration:
# SHIYE_DEPLOYMENT=cloud-test
# SHIYE_HOST=0.0.0.0
# SHIYE_PORT=3000
# SHIYE_PUBLIC_ORIGIN=https://YOUR-ASSIGNED-HOST (no path or trailing slash)
# SHIYE_RUNTIME_DIR=/tmp/shiye-disposable-test
# SHIYE_ALLOW_EPHEMERAL_TEST_DATA=true
# SHIYE_INITIAL_ADMIN_USERNAME=<test account name>
# SHIYE_INITIAL_ADMIN_PASSWORD=<secret, at least 12 characters>
# These are disposable technical tests only. Production persistence is not connected.
# The gateway must terminate HTTPS and preserve Host. Forwarded headers are not trusted.
